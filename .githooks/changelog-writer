#!/usr/bin/env bash
# .githooks/changelog-writer
# ─────────────────────────────────────────────────────────────
# Post-commit changelog writer.
# Called from post-commit hook after the code review runs.
# Sends commit metadata + diff to Qwen via Ollama API.
# Prepends the resulting entry to CHANGELOG.md.
#
# Skips commits with prefixes: chore: wip:
# ─────────────────────────────────────────────────────────────

set -euo pipefail

OLLAMA_URL="http://localhost:11434/api/generate"
OLLAMA_MODEL="qwen3.5:9b-32k"
CHANGELOG_FILE="CHANGELOG.md"
AGENT_FILE=".opencode/agents/de-changelog-writer.md"
TIMEOUT_SECONDS=120
POSTS_DIR=".posts"

# ── Colours ───────────────────────────────────────────────────
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

log()  { echo -e "${BLUE}[changelog]${NC} $*"; }
warn() { echo -e "${YELLOW}[changelog]${NC} $*"; }
ok()   { echo -e "${GREEN}[changelog]${NC} $*"; }

REPO_ROOT="$(git rev-parse --show-toplevel)"
PYTHON="${REPO_ROOT}/.venv/Scripts/python.exe"
cd "$REPO_ROOT"


# ── Check Ollama is running ───────────────────────────────────
if ! curl -s --max-time 3 "$OLLAMA_URL" > /dev/null 2>&1; then
  warn "Ollama not reachable at ${OLLAMA_URL} — skipping changelog."
  warn "Start Ollama with: ollama serve"
  exit 0
fi

# ── Check commit prefix — skip chore and wip ─────────────────
COMMIT_MSG=$(git log -1 --format="%s")
COMMIT_PREFIX=$(echo "$COMMIT_MSG" | cut -d: -f1)

if [[ "$COMMIT_PREFIX" == "chore" ]] || [[ "$COMMIT_PREFIX" == "wip" ]]; then
  log "Skipping changelog for '${COMMIT_PREFIX}:' commit."
  exit 0
fi

# ── Gather commit metadata ────────────────────────────────────
COMMIT_HASH=$(git log -1 --format="%h")
COMMIT_DATE=$(git log -1 --format="%ad" --date=format:'%Y-%m-%d')
BRANCH=$(git rev-parse --abbrev-ref HEAD)

# Files changed in last commit
if git rev-parse HEAD~1 &>/dev/null 2>&1; then
  FILES_CHANGED=$(git diff HEAD~1 HEAD --name-only 2>/dev/null | tr '\n' ',' | sed 's/,$//')
  DIFF=$(git diff HEAD~1 HEAD 2>/dev/null)
else
  FILES_CHANGED=$(git diff-tree --no-commit-id -r --name-only HEAD 2>/dev/null | tr '\n' ',' | sed 's/,$//')
  DIFF=$(git show HEAD 2>/dev/null)
fi

log "Writing changelog entry for: ${COMMIT_MSG}"

# ── Read agent system prompt ──────────────────────────────────
if [[ ! -f "$AGENT_FILE" ]]; then
  warn "Agent file not found: ${AGENT_FILE} — skipping changelog."
  exit 0
fi

# Strip YAML frontmatter, keep body
SYSTEM_PROMPT=$(awk '/^---/{p++; next} p==2{print}' "$AGENT_FILE")

# ── Build input payload via temp files ───────────────────────
# Use TMPDIR — works on Windows Git Bash unlike /tmp
INPUT_FILE=$(mktemp /tmp/changelog_input_XXXXXX.txt)
SYSTEM_FILE=$(mktemp /tmp/changelog_system_XXXXXX.txt)
TEMP_CHANGELOG=$(mktemp /tmp/changelog_XXXXXX.md)
trap 'rm -f "$TEMP_CHANGELOG" "$INPUT_FILE" "$SYSTEM_FILE"' EXIT


echo "$SYSTEM_PROMPT" > "$SYSTEM_FILE"
cat > "$INPUT_FILE" <<EOF
=== COMMIT HASH ===
${COMMIT_HASH}

=== BRANCH ===
${BRANCH}

=== DATE ===
${COMMIT_DATE}

=== COMMIT MESSAGE ===
${COMMIT_MSG}

=== FILES CHANGED ===
${FILES_CHANGED}

=== DIFF ===
${DIFF}
EOF

# Build JSON payload using Python reading from files — no shell escaping issues
JSON_PAYLOAD=$("$PYTHON" -c "
import json
with open('${SYSTEM_FILE}') as f:
    system = f.read()
with open('${INPUT_FILE}') as f:
    prompt = '/no_think\n\n' + f.read()
payload = {
    'model': '${OLLAMA_MODEL}',
    'system': system,
    'prompt': prompt,
    'stream': False,
    'options': {
        'temperature': 0.4,
        'num_predict': 1024,
        'num_ctx': 32768
    }
}
print(json.dumps(payload))
")

# ── Call Ollama API ───────────────────────────────────────────
RESPONSE=$(curl -s --max-time "$TIMEOUT_SECONDS" \
  -X POST "$OLLAMA_URL" \
  -H "Content-Type: application/json" \
  -d "$JSON_PAYLOAD") || {
    warn "Ollama API call failed — skipping changelog."
    exit 0
  }

echo "[changelog DEBUG] Raw response: '${RESPONSE:0:500}'"

# Extract the response text
ENTRY=$(echo "$RESPONSE" | "$PYTHON" -c "
import json, sys
try:
    data = json.load(sys.stdin)
    print(data.get('response', '').strip())
except Exception as e:
    print('')
")
# DEBUG — remove after testing
echo "[changelog DEBUG] Raw entry: '${ENTRY:0:200}'"

# ── Check for SKIP signal ─────────────────────────────────────
if [[ "$ENTRY" == "SKIP" ]] || [[ -z "$ENTRY" ]]; then
  log "Changelog entry skipped by agent."
  exit 0
fi

# ── Prepend entry to CHANGELOG.md ─────────────────────────────


if [[ -f "$CHANGELOG_FILE" ]]; then
  # Prepend new entry before existing content
  {
    echo "$ENTRY"
    echo ""
    cat "$CHANGELOG_FILE"
  } > "$TEMP_CHANGELOG"
else
  # First entry — add file header
  {
    echo "# Changelog"
    echo ""
    echo "> Auto-generated by de-changelog-writer (Qwen ${OLLAMA_MODEL})"
    echo "> Consumed by de-linkedin-general and de-linkedin-technical agents"
    echo "> See CONTRIBUTING.md for commit conventions"
    echo ""
    echo "$ENTRY"
  } > "$TEMP_CHANGELOG"
fi

cp "$TEMP_CHANGELOG" "$CHANGELOG_FILE"
ok "Changelog updated: ${CHANGELOG_FILE}"
echo ""
echo "─── New entry ────────────────────────────────"
echo "$ENTRY"
echo "──────────────────────────────────────────────"

#!/usr/bin/env bash
# .githooks/linkedin-general
# ─────────────────────────────────────────────────────────────
# Generates a general audience LinkedIn post from CHANGELOG.md.
# Uses Qwen via Ollama. Run manually when ready to post.
#
# Usage:
#   bash .githooks/linkedin-general              # last 2 weeks
#   bash .githooks/linkedin-general --days 7     # last 7 days
#   bash .githooks/linkedin-general --all        # full changelog
# ─────────────────────────────────────────────────────────────

set -euo pipefail

OLLAMA_URL="http://localhost:11434/api/generate"
OLLAMA_MODEL="qwen3.5:9b-32k"
CHANGELOG_FILE="CHANGELOG.md"
AGENT_FILE=".opencode/agents/de-linkedin-general.md"
TIMEOUT_SECONDS=180
POSTS_DIR=".posts"
DAYS=14

# ── Parse args ────────────────────────────────────────────────
USE_ALL=false
while [[ $# -gt 0 ]]; do
  case $1 in
    --days) DAYS="$2"; shift 2 ;;
    --all)  USE_ALL=true; shift ;;
    *) shift ;;
  esac
done

# ── Colours ───────────────────────────────────────────────────
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

log()  { echo -e "${BLUE}[linkedin-general]${NC} $*"; }
warn() { echo -e "${YELLOW}[linkedin-general]${NC} $*"; }
ok()   { echo -e "${GREEN}[linkedin-general]${NC} $*"; }

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# ── Checks ────────────────────────────────────────────────────
if [[ ! -f "$CHANGELOG_FILE" ]]; then
  warn "CHANGELOG.md not found — commit some changes first."
  exit 1
fi

if ! curl -s --max-time 3 "$OLLAMA_URL" > /dev/null 2>&1; then
  warn "Ollama not reachable at ${OLLAMA_URL}"
  warn "Start with: ollama serve"
  exit 1
fi

if [[ ! -f "$AGENT_FILE" ]]; then
  warn "Agent file not found: ${AGENT_FILE}"
  exit 1
fi

# ── Filter changelog by date ──────────────────────────────────
if [[ "$USE_ALL" == "true" ]]; then
  CHANGELOG_CONTENT=$(cat "$CHANGELOG_FILE")
  log "Using full changelog"
else
  CUTOFF_DATE=$(date -d "-${DAYS} days" '+%Y-%m-%d' 2>/dev/null || \
    date -v-${DAYS}d '+%Y-%m-%d' 2>/dev/null || \
    python3 -c "from datetime import datetime, timedelta; print((datetime.now()-timedelta(days=${DAYS})).strftime('%Y-%m-%d'))")

  log "Using changelog entries since ${CUTOFF_DATE}"

  # Extract entries — each entry ends with a line containing only "---"
  CHANGELOG_CONTENT=$(python3 - <<EOF
import re, sys
with open("${CHANGELOG_FILE}") as f:
    content = f.read()

cutoff = "${CUTOFF_DATE}"
entries = re.split(r'\n---\n', content)
recent = []
for entry in entries:
    # Look for date in entry header: — YYYY-MM-DD
    match = re.search(r'— (\d{4}-\d{2}-\d{2})', entry)
    if match and match.group(1) >= cutoff:
        recent.append(entry)

print('\n---\n'.join(recent) if recent else "No recent entries found.")
EOF
)
fi

if [[ -z "$CHANGELOG_CONTENT" ]] || [[ "$CHANGELOG_CONTENT" == "No recent entries found." ]]; then
  warn "No changelog entries found for the requested period."
  warn "Try --all or --days 30"
  exit 0
fi

# ── Read agent system prompt ──────────────────────────────────
SYSTEM_PROMPT=$(awk '/^---/{p++; next} p==2{print}' "$AGENT_FILE")

# ── Call Ollama ───────────────────────────────────────────────
log "Generating general audience LinkedIn post..."

RESPONSE=$(curl -s --max-time "$TIMEOUT_SECONDS" \
  -X POST "$OLLAMA_URL" \
  -H "Content-Type: application/json" \
  -d "{
    \"model\": \"${OLLAMA_MODEL}\",
    \"system\": $(echo "$SYSTEM_PROMPT" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))'),
    \"prompt\": $(echo "Write a general audience LinkedIn post based on these changelog entries:\n\n${CHANGELOG_CONTENT}" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))'),
    \"stream\": false,
    \"options\": {
      \"temperature\": 0.7,
      \"num_predict\": 2048
    }
  }") || {
    warn "Ollama API call failed."
    exit 1
  }

POST=$(echo "$RESPONSE" | python3 -c "
import json, sys
try:
    data = json.load(sys.stdin)
    print(data.get('response', '').strip())
except:
    print('')
")

if [[ -z "$POST" ]] || [[ "$POST" == NO_POST* ]]; then
  warn "Agent returned no post: ${POST:-empty response}"
  exit 0
fi

# ── Save and display ──────────────────────────────────────────
mkdir -p "$POSTS_DIR"
TIMESTAMP=$(date '+%Y-%m-%d_%H-%M')
POST_FILE="${POSTS_DIR}/linkedin-general-${TIMESTAMP}.md"

{
  echo "# LinkedIn Post — General Audience"
  echo "**Generated:** ${TIMESTAMP}"
  echo "**Model:** ${OLLAMA_MODEL}"
  echo ""
  echo "---"
  echo ""
  echo "$POST"
} > "$POST_FILE"

echo ""
echo "══════════════════════════════════════════════"
echo "$POST"
echo "══════════════════════════════════════════════"
echo ""
ok "Post saved to ${POST_FILE}"

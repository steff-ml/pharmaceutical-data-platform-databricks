#!/usr/bin/env bash
# .githooks/post-commit
# ─────────────────────────────────────────────────────────────
# Post-commit hook: runs static analysis tools + Claude code review
# on Python files in the last commit.
# Writes report to .reviews/last-review.md
#
# Setup (run once):
#   git config core.hooksPath .githooks
#   chmod +x .githooks/post-commit
#
# Dependencies: ruff, mypy, pytest, bandit, interrogate, claude
# Install:  pip install ruff mypy pytest bandit interrogate
# ─────────────────────────────────────────────────────────────

set -euo pipefail

# ── Config ────────────────────────────────────────────────────
DIFF_WARN_THRESHOLD=400
DIFF_SKIP_THRESHOLD=800
REVIEWS_DIR=".reviews"
REPORT_FILE="${REVIEWS_DIR}/last-review.md"
ARCH_REPORT_FILE="${REVIEWS_DIR}/last-arch-review.md"
CLAUDE_AGENT="de-code-reviewer"
CLAUDE_ARCH_AGENT="de-arch-reviewer"
TIMEOUT_SECONDS=120

# ── Colours ───────────────────────────────────────────────────
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

# ── Helpers ───────────────────────────────────────────────────
log()  { echo -e "${BLUE}[review]${NC} $*"; }
warn() { echo -e "${YELLOW}[review]${NC} $*"; }
ok()   { echo -e "${GREEN}[review]${NC} $*"; }

# ── Virtual environment activation ───────────────────────────
REPO_ROOT="$(git rev-parse --show-toplevel)"
VENV_PATH="${REPO_ROOT}/.venv/Scripts"

if [[ -d "$VENV_PATH" ]]; then
  export PATH="${VENV_PATH}:${PATH}"
  hash -r
  log "Virtual environment activated"
else
  warn "No .venv found at repo root — tools may not be available"
fi

# ── Dependency check ──────────────────────────────────────────
MISSING_DEPS=()

for dep in ruff mypy bandit interrogate pytest; do
  if [[ ! -f "${VENV_PATH}/${dep}.exe" ]] && \
     [[ ! -f "${VENV_PATH}/${dep}" ]]; then
    MISSING_DEPS+=("$dep")
  fi
done

for dep in claude; do
  if ! which "$dep" &>/dev/null 2>&1; then
    MISSING_DEPS+=("$dep")
  fi
done

if [[ ${#MISSING_DEPS[@]} -gt 0 ]]; then
  warn "Missing dependencies: ${MISSING_DEPS[*]}"
  warn "Install with:"
  warn "  Python tools:  pip install ruff mypy bandit interrogate pytest"
  warn "  claude:        See https://claude.ai/code"
  warn "Skipping review — commit recorded anyway."
  exit 0
fi

# ── Gather Python files from last commit ─────────────────────
# Use HEAD~1..HEAD for normal commits, root commit fallback
if git rev-parse HEAD~1 &>/dev/null 2>&1; then
  COMMITTED_PY=$(git diff HEAD~1 HEAD --name-only --diff-filter=ACM \
    2>/dev/null | grep '\.py$' || true)
else
  # First commit in repo — list all tracked Python files
  COMMITTED_PY=$(git diff-tree --no-commit-id -r --name-only HEAD \
    2>/dev/null | grep '\.py$' || true)
fi

if [[ -z "$COMMITTED_PY" ]]; then
  ok "No Python files in last commit — skipping review."
  exit 0
fi

log "Python files in last commit:"
echo "$COMMITTED_PY" | sed 's/^/  /'

# ── Write diff to temp file ───────────────────────────────────
DIFF_FILE=$(mktemp /tmp/review_diff_XXXXXX.patch)
TOOLS_FILE=$(mktemp /tmp/review_tools_XXXXXX.txt)
trap 'rm -f "$DIFF_FILE" "$TOOLS_FILE"' EXIT

if git rev-parse HEAD~1 &>/dev/null 2>&1; then
  git diff HEAD~1 HEAD -- $(echo "$COMMITTED_PY") > "$DIFF_FILE"
else
  git show HEAD -- $(echo "$COMMITTED_PY") > "$DIFF_FILE"
fi

DIFF_LINES=$(wc -l < "$DIFF_FILE" | tr -d ' ')
log "Diff size: ${DIFF_LINES} lines"

if (( DIFF_LINES > DIFF_SKIP_THRESHOLD )); then
  warn "Diff exceeds ${DIFF_SKIP_THRESHOLD} lines — skipping Claude review, running tools only."
  SKIP_CLAUDE=true
else
  SKIP_CLAUDE=false
  if (( DIFF_LINES > DIFF_WARN_THRESHOLD )); then
    warn "Large diff (${DIFF_LINES} lines) — consider breaking into smaller commits."
  fi
fi

# ── Run static analysis tools ─────────────────────────────────
# Write tool results to a plain text file — no JSON escaping needed

{
  echo "=== BRANCH ==="
  git rev-parse --abbrev-ref HEAD

  echo "=== COMMITTED FILES ==="
  echo "$COMMITTED_PY"

  echo "=== DIFF_LINES ==="
  echo "$DIFF_LINES"

  echo "=== RUFF ==="
  log "Running ruff..."
  ruff check --output-format=concise $(echo "$COMMITTED_PY") 2>&1 \
    && echo "EXIT:0" || echo "EXIT:$?"

  echo "=== MYPY ==="
  log "Running mypy..."
  mypy --ignore-missing-imports --no-error-summary \
    $(echo "$COMMITTED_PY") 2>&1 \
    && echo "EXIT:0" || echo "EXIT:$?"

  echo "=== BANDIT ==="
  log "Running bandit..."
  bandit -r -ll -q $(echo "$COMMITTED_PY") 2>&1 \
    && echo "EXIT:0" || echo "EXIT:$?"

  echo "=== INTERROGATE ==="
  log "Running interrogate..."
  interrogate --fail-under=70 $(echo "$COMMITTED_PY") 2>&1 \
    && echo "EXIT:0" || echo "EXIT:$?"

  echo "=== PYTEST ==="
  log "Running pytest..."
  if [[ -d "tests" ]]; then
    pytest tests/ -q --tb=short --no-header 2>&1 \
      && echo "EXIT:0" || echo "EXIT:$?"
  else
    echo "No tests/ directory found"
    echo "EXIT:-1"
  fi

} > "$TOOLS_FILE" 2>&1

# ── Run Claude review ─────────────────────────────────────────
mkdir -p "$REVIEWS_DIR"

if [[ "$SKIP_CLAUDE" == "true" ]]; then
  cat > "$REPORT_FILE" <<EOF
# Code Review — $(git rev-parse --abbrev-ref HEAD) @ $(date '+%Y-%m-%d %H:%M')

> ⚠️ Diff too large (${DIFF_LINES} lines) — Claude review skipped. Tools ran only.
> Consider breaking this commit into smaller, focused changes.

## Tool Results
See terminal output above for individual tool results.

> Commit recorded. Review is advisory only.
EOF
  ok "Tools complete. Claude review skipped (diff too large)."

else
  log "Running Claude review (agent: ${CLAUDE_AGENT})..."

  PROMPT="You are the de-code-reviewer agent. Review the following code change.

## Diff
The git diff is in: ${DIFF_FILE}
Read it with the Read tool.

## Tool Results
The tool output is in: ${TOOLS_FILE}
Read it with the Read tool.

The tools file uses === SECTION === headers to separate each tool's output.
EXIT:0 means the tool passed. EXIT:1 or higher means it failed. EXIT:-1 means skipped.

Produce the review report as specified in your agent instructions.
Write the final report to: ${REPO_ROOT}/${REPORT_FILE}"

  timeout "$TIMEOUT_SECONDS" claude --agent "$CLAUDE_AGENT" --print "$PROMPT" \
    > /tmp/claude_review_output.txt 2>&1 || {
      warn "Claude review timed out or failed — commit recorded anyway."
      echo "> Claude review failed. Tools ran successfully." > "$REPORT_FILE"
    }

  # Claude writes the report itself via the Write tool
  # If it didn't, fall back to its stdout output
  if [[ ! -f "$REPORT_FILE" ]] || [[ ! -s "$REPORT_FILE" ]]; then
    if [[ -s /tmp/claude_review_output.txt ]]; then
      cp /tmp/claude_review_output.txt "$REPORT_FILE"
    fi
  fi
fi

# ── Print report ──────────────────────────────────────────────
if [[ -f "$REPORT_FILE" ]] && [[ -s "$REPORT_FILE" ]]; then
  echo ""
  echo "──────────────────────────────────────────────"
  cat "$REPORT_FILE"
  echo "──────────────────────────────────────────────"
  echo ""
  ok "Full report saved to ${REPORT_FILE}"
fi

# ── Arch review on large diffs ────────────────────────────────
if (( DIFF_LINES > DIFF_WARN_THRESHOLD )) && [[ "$SKIP_CLAUDE" == "false" ]]; then
  log "Large diff — also running architecture review..."

  ARCH_PROMPT="You are the de-arch-reviewer agent. Review the following code change.

## Diff
The git diff is in: ${DIFF_FILE}
Read it with the Read tool.

## Tool Results
The tool output is in: ${TOOLS_FILE}
Read it with the Read tool.

Produce the architecture review report as specified in your agent instructions.
Write the final report to: ${REPO_ROOT}/${ARCH_REPORT_FILE}"

  timeout "$TIMEOUT_SECONDS" claude --agent "$CLAUDE_ARCH_AGENT" --print \
    "$ARCH_PROMPT" > /dev/null 2>&1 || {
      warn "Architecture review timed out or failed — skipping."
    }

  if [[ -f "$ARCH_REPORT_FILE" ]] && [[ -s "$ARCH_REPORT_FILE" ]]; then
    echo ""
    echo "──────────────────────────────────────────────"
    cat "$ARCH_REPORT_FILE"
    echo "──────────────────────────────────────────────"
    ok "Architecture report saved to ${ARCH_REPORT_FILE}"
  fi
fi

# ── Run changelog writer ─────────────────────────────────────
CHANGELOG_SCRIPT="${REPO_ROOT}/.githooks/changelog-writer"
if [[ -f "$CHANGELOG_SCRIPT" ]]; then
  bash "$CHANGELOG_SCRIPT" || warn "Changelog writer failed — commit recorded anyway."
fi

# ── Done ──────────────────────────────────────────────────────
exit 0
